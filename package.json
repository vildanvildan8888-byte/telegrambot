{
  "name": "telegram-food-delivery-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram food delivery bot built with Telegraf and PostgreSQL",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "test": "node scripts/run-tests.js",
    "check": "node --check scripts/check-syntax.js && node scripts/check-syntax.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.16.3",
    "telegraf": "^4.16.3"
  }
}
